---
// Wordmark: "idea" at 700, "collaborative" at 400, one word, lowercase, -0.02em.
// On light: idea Navy, collaborative Deep Teal. On dark: idea White,
// collaborative Teal Light. The tail stays at 400, not 300: 300 goes thin and
// pale at nav size, which is where the wordmark is smallest.
export interface Props {
  dark?: boolean;
  class?: string;
}
const { dark = false, class: cls = '' } = Astro.props;
---

<span class:list={['wordmark', cls]}>
  <span class="mark-line"
    ><b style={`color:${dark ? '#fff' : 'var(--color-navy)'}`}>idea</b><span
      class="tail"
      style={`color:${dark ? 'var(--color-teal-light)' : 'var(--color-teal-deep)'}`}
      >collaborative</span
    ></span
  >
</span>

<style>
  .wordmark { display: inline-flex; flex-direction: column; }
  .mark-line { display: block; }
</style>
