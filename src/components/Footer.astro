---
import Wordmark from './Wordmark.astro';
import ContactBlock from './ContactBlock.astro';
import { brand } from '../data/contact';
import { tiers } from '../data/offers';

const year = new Date().getFullYear();
const cols = [
  {
    heading: 'Workshops',
    links: [
      { href: '/workshops', label: 'All three levels' },
      ...tiers.map((t) => ({
        href: `/workshops/${t.slug}`,
        label: t.shortTitle,
      })),
      { href: '/realtors', label: 'AI for Real Estate' },
    ],
  },
  {
    heading: 'Services',
    links: [
      { href: '/consulting', label: 'Consulting and implementation' },
      { href: '/ai-readiness-assessment', label: 'Free readiness assessment' },
      { href: '/ai-briefing-breakfast', label: 'AI Briefing Breakfast' },
    ],
  },
  {
    heading: 'Company',
    links: [
      { href: '/about', label: 'About' },
      // TEMP: hide Blog from footer; /blog stays reachable by direct URL
      // { href: '/blog', label: 'Blog' },
      { href: '/contact', label: 'Contact' },
      { href: '/privacy', label: 'Privacy' },
    ],
  },
];
---

<footer class="site-footer on-dark">
  <div class="shell">
    <div class="grid">
      <div class="brand-col">
        <img src="/logo-white.svg" alt="" width="120" height="78" class="mark" />
        <Wordmark dark full class="word" />
        <p class="tagline">{brand.tagline}</p>
        <ContactBlock dark class="contact" />
      </div>

      {cols.map((c) => (
        <nav aria-label={c.heading}>
          <h2>{c.heading}</h2>
          <ul>
            {c.links.map((l) => (
              <li><a href={l.href}>{l.label}</a></li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="base">
      <p>&copy; {year} Idea Collaborative. Loveland, Colorado.</p>
      <p class="fine">
        Serving Loveland, Fort Collins, Windsor, Greeley, and Longmont.
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--color-ink);
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem) 2rem;
    margin-top: auto;
  }
  .grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .grid { grid-template-columns: 1.4fr repeat(3, 1fr); gap: 3rem; } }

  .mark { height: 2.5rem; width: auto; }
  .word { font-size: 1.75rem; margin-top: 1rem; display: block; }
  .tagline {
    font-family: var(--font-display);
    font-size: 1.125rem;
    margin: 0.5rem 0 1.5rem;
    color: var(--color-teal-pale);
  }
  .contact { margin-top: 0.5rem; }

  h2 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-teal-light);
    margin: 0 0 1rem;
  }
  ul { list-style: none; margin: 0; padding: 0; }
  li + li { margin-top: 0.625rem; }
  .grid a {
    font-size: 0.9375rem;
    color: color-mix(in oklab, var(--color-cloud) 84%, var(--color-teal-pale));
    text-decoration: none;
  }
  .grid a:hover { color: #fff; text-decoration: underline; text-underline-offset: 3px; }

  .base {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    justify-content: space-between;
    font-size: 0.8125rem;
  }
  .base p { margin: 0; color: color-mix(in oklab, var(--color-teal-pale) 80%, transparent); }
</style>
