---
import { localBusiness, organizationNode, webSite } from '../data/schema';

export interface Props {
  title: string;
  description: string;
  /** Route path, no trailing slash, e.g. "/workshops". */
  path: string;
  ogImage?: string;
  /** Accessible description of the OG image. Defaults to the page title. */
  ogImageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /**
   * Extra JSON-LD for this page. Home also gets ProfessionalService + WebSite.
   * Other pages get a compact Organization node so provider/author `@id` refs resolve.
   */
  schemas?: unknown[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  path,
  ogImage = '/images/og-default.jpg',
  ogImageAlt,
  type = 'website',
  noindex = false,
  schemas = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const site = Astro.site?.origin ?? 'https://ideacollaborative.com';
const canonical = `${site}${path === '/' ? '' : path}`;
const image = ogImage.startsWith('http') ? ogImage : `${site}${ogImage}`;
const imageAlt = ogImageAlt ?? title;

// Guide-adjacent SEO rule from PLAN.md section 6: title under 60 characters,
// description under 155. Fail the build rather than ship a truncated result.
if (import.meta.env.PROD) {
  if (title.length > 60) throw new Error(`SEO title too long (${title.length}) on ${path}: ${title}`);
  if (description.length > 155) throw new Error(`SEO description too long (${description.length}) on ${path}`);
}

const entityBlocks =
  path === '/' ? [localBusiness, webSite] : [organizationNode];
const blocks = [...entityBlocks, ...schemas];
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:site_name" content="Idea Collaborative" />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<meta name="geo.region" content="US-CO" />
<meta name="geo.placename" content="Loveland, Colorado" />

{blocks.map((b) => (
  <script type="application/ld+json" set:html={JSON.stringify(b)} />
))}
