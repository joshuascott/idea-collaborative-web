---
import { mark } from '../../data/mark';

// Signature moment 1, the mark scene. Content-sized section (no pinned stage,
// so no empty Ink field). Only the SVG stroke paths animate: the loops draw
// when the section enters view, and again each time you scroll back to it.
// Reduced motion and no-JS both show the finished mark.
//
// The mark is drawn in flat white, not navy and teal. The scene sits on Ink, and
// the guide allows the two-colour mark only on white, Cloud, or Mist (section 3,
// logo don'ts). The two loops stay readable as two separate gestures through the
// draw order and a slight difference in opacity rather than through colour.
const lines = [
  'Most AI advice is a lecture.',
  'Ours is a loop: you show us the workflow, we build the capability, you test it, we refine it.',
  'That loop is the mark of Idea Collaborative.',
];
---

<section class="scene on-dark" aria-labelledby="mark-scene-heading" data-mark-scene>
  <div class="shell inner">
    <div class="art">
      <svg viewBox={mark.viewBox} aria-hidden="true" focusable="false">
        <defs>
          <mask id="ms-a" maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
            <rect width="1024" height="1024" fill="#fff" />
            <path d={mark.tealBar} stroke="#000" stroke-width={mark.knockout} stroke-linecap="round" />
          </mask>
          <mask id="ms-b" maskUnits="userSpaceOnUse" x="0" y="0" width="1024" height="1024">
            <rect width="1024" height="1024" fill="#fff" />
            <path d={mark.navyBar} stroke="#000" stroke-width={mark.knockout} stroke-linecap="round" />
          </mask>
        </defs>

        <g mask="url(#ms-b)">
          <path class="tail" d={mark.tail} fill="#FFFFFF" />
          <path
            class="loop teal"
            d={mark.teal}
            pathLength="1"
            stroke="#FFFFFF"
            stroke-width={mark.strokeWidth}
            stroke-linecap="round"
            fill="none"
          />
        </g>
        <path
          class="loop navy"
          d={mark.navy}
          pathLength="1"
          mask="url(#ms-a)"
          stroke="#FFFFFF"
          stroke-width={mark.strokeWidth}
          stroke-linecap="round"
          fill="none"
        />
      </svg>
    </div>

    <div class="text">
      <p class="chapter is-dark">
        <span>02</span><span aria-hidden="true">/</span><span>The mark</span>
      </p>
      <h2 id="mark-scene-heading" class="sr-only">The mark</h2>
      <ol class="lines">
        {lines.map((l) => <li>{l}</li>)}
      </ol>
    </div>
  </div>
</section>

<style>
  .scene {
    background: var(--color-ink);
    position: relative;
    padding-block: clamp(2.75rem, 2rem + 3vw, 4.5rem);
  }
  .inner {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: center;
  }
  .art { justify-self: center; width: min(100%, 18rem); }
  .art svg { width: 100%; height: auto; overflow: visible; }
  /* The second loop sits back a little so the two gestures read apart. */
  .teal, .tail { opacity: 0.74; }
  .text { max-width: 36rem; }
  .chapter { margin: 0 0 0.85rem; }
  .lines { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .lines li {
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
    font-size: clamp(1.1875rem, 1.05rem + 0.7vw, 1.5625rem);
    color: var(--color-cloud);
  }

  @media (min-width: 1024px) {
    .inner { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr); gap: 2.75rem; }
    .art { width: min(100%, 22rem); }
  }

  /* Default = finished mark. Motion peels that back only when JS arms the scene. */
  @media (prefers-reduced-motion: no-preference) {
    .scene[data-armed] .loop {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
    }
    .scene[data-armed] .tail {
      opacity: 0;
      transform: scale(0.9);
      transform-box: fill-box;
      transform-origin: 20% 20%;
    }
    .scene[data-playing] .navy {
      animation: draw-loop 1.05s var(--ease-out-quart) forwards;
    }
    .scene[data-playing] .teal {
      animation: draw-loop 1.05s 0.4s var(--ease-out-quart) forwards;
    }
    .scene[data-playing] .tail {
      animation: pop-tail 0.45s 1.15s var(--ease-out-quart) forwards;
    }
  }

  @keyframes draw-loop {
    from { stroke-dashoffset: 1; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes pop-tail {
    from { opacity: 0; transform: scale(0.9); }
    to { opacity: 0.74; transform: none; }
  }
</style>

<script>
  const wire = () => {
    const root = document.querySelector<HTMLElement>('[data-mark-scene]');
    if (!root || root.dataset.wired === 'true') return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    root.dataset.wired = 'true';
    root.setAttribute('data-armed', '');

    let busy = false;
    const play = () => {
      if (busy) return;
      busy = true;
      root.removeAttribute('data-playing');
      void root.offsetWidth;
      root.setAttribute('data-playing', '');
      window.setTimeout(() => {
        busy = false;
      }, 1700);
    };

    // Play on enter, and again each time the section is left and re-entered.
    let wasIn = false;
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.isIntersecting) {
          if (!wasIn) play();
          wasIn = true;
        } else {
          wasIn = false;
        }
      },
      { threshold: 0.4 }
    );
    io.observe(root);
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
