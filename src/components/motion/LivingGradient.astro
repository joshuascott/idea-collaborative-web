---
// Signature moment 2. Three soft radial blobs on the signature gradient. They
// drift on their own and lean toward the pointer with heavy damping, so the
// surface breathes rather than chases. Layered CSS radial-gradients driven by
// registered custom properties; positions nudged by a small rAF loop. No WebGL,
// no canvas, no particles.
export interface Props {
  /** Opacity of the whole layer over whatever sits beneath it. */
  strength?: number;
  class?: string;
}
const { strength = 0.3, class: cls = '' } = Astro.props;
---

<div
  class:list={['living', cls]}
  data-living-gradient
  aria-hidden="true"
  style={`--strength:${strength}`}
>
</div>

<style>
  @property --lx { syntax: '<percentage>'; inherits: true; initial-value: 50%; }
  @property --ly { syntax: '<percentage>'; inherits: true; initial-value: 50%; }

  .living {
    position: absolute;
    inset: 0;
    opacity: var(--strength);
    pointer-events: none;
    background:
      radial-gradient(
        42rem 30rem at calc(22% + var(--lx, 50%) * 0.06) calc(28% + var(--ly, 50%) * 0.05),
        color-mix(in oklab, #3c8e8e 70%, transparent) 0%,
        transparent 62%
      ),
      radial-gradient(
        38rem 26rem at calc(74% - var(--lx, 50%) * 0.05) calc(30% + var(--ly, 50%) * 0.07),
        color-mix(in oklab, #2c6671 78%, transparent) 0%,
        transparent 60%
      ),
      radial-gradient(
        46rem 32rem at calc(48% + var(--lx, 50%) * 0.04) calc(84% - var(--ly, 50%) * 0.06),
        color-mix(in oklab, #1c3e54 85%, transparent) 0%,
        transparent 66%
      );
    transition: --lx 900ms cubic-bezier(0.16, 1, 0.3, 1), --ly 900ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* The blobs also drift on their own, slowly, on a long cycle. */
  @media (prefers-reduced-motion: no-preference) {
    .living { animation: drift 52s ease-in-out infinite alternate; }
  }
  @keyframes drift {
    from { background-position: 0% 0%, 0% 0%, 0% 0%; }
    to { background-position: 4% 3%, -4% 2%, 2% -3%; }
  }
</style>

<script>
  const wire = () => {
    const nodes = document.querySelectorAll<HTMLElement>('[data-living-gradient]');
    if (!nodes.length) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let tx = 50, ty = 50, x = 50, y = 50, raf = 0, running = false;

    const tick = () => {
      // Heavy damping. The surface leans, it does not follow.
      x += (tx - x) * 0.045;
      y += (ty - y) * 0.045;
      nodes.forEach((n) => {
        n.style.setProperty('--lx', x.toFixed(2) + '%');
        n.style.setProperty('--ly', y.toFixed(2) + '%');
      });
      if (Math.abs(tx - x) > 0.05 || Math.abs(ty - y) > 0.05) {
        raf = requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };
    const start = () => {
      if (!running) { running = true; raf = requestAnimationFrame(tick); }
    };

    const onPointer = (e: PointerEvent) => {
      if (e.pointerType === 'touch') return;
      tx = (e.clientX / window.innerWidth) * 100;
      ty = (e.clientY / window.innerHeight) * 100;
      start();
    };
    // On touch the surface answers the scroll instead of the pointer.
    const onScroll = () => {
      const p = window.scrollY / Math.max(1, document.body.scrollHeight - window.innerHeight);
      ty = 20 + p * 60;
      tx = 50 + Math.sin(p * Math.PI * 2) * 18;
      start();
    };

    window.addEventListener('pointermove', onPointer, { passive: true });
    if (matchMedia('(hover: none)').matches) {
      window.addEventListener('scroll', onScroll, { passive: true });
    }
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
