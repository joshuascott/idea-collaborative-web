---
import Wordmark from './Wordmark.astro';
import Menu from 'lucide-astro/Menu';
import X from 'lucide-astro/X';
import ChevronDown from 'lucide-astro/ChevronDown';
import { cta } from '../data/offers';

export interface Props {
  /** True when the nav sits over a dark hero and starts transparent. */
  overDark?: boolean;
}
const { overDark = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

import { tiers } from '../data/offers';

const links = [
  {
    href: '/workshops',
    label: 'Workshops',
    children: [
      ...tiers.map((t) => ({ href: `/workshops/${t.slug}`, label: t.title })),
      { href: '/realtors', label: 'For brokerages' },
    ],
  },
  { href: '/consulting', label: 'Consulting' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!-- 24px tall so the nav flips to its solid state after 24px of scroll.
     A zero-height sentinel can never intersect. -->
<div id="nav-sentinel" aria-hidden="true"></div>

<header
  class:list={['site-nav', overDark && 'over-dark']}
  data-over-dark={overDark ? 'true' : 'false'}
>
  <div class="shell nav-inner">
    <a href="/" class="brand" aria-label="ideacollab, Idea Collaborative home">
      <img src="/logo.svg" alt="" width="44" height="29" class="mark light-mark" />
      <img src="/logo-white.svg" alt="" width="44" height="29" class="mark dark-mark" />
      <span transition:name="wordmark"><Wordmark full class="brand-word" /></span>
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {links.map((l) =>
          l.children ? (
            <li class="has-menu" data-menu>
              <a
                href={l.href}
                class="group-link"
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
              <button
                type="button"
                class="disclose"
                aria-expanded="false"
                aria-label={`Show ${l.label} pages`}
                data-menu-toggle
              >
                <ChevronDown size={15} stroke-width={2} aria-hidden="true" />
              </button>
              <div class="panel" data-menu-panel hidden>
                <ul>
                  {l.children.map((c) => (
                    <li>
                      <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </li>
          ) : (
            <li>
              <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          )
        )}
      </ul>
      <a href={cta.primary.href} class="btn btn-primary nav-cta">{cta.primary.label}</a>
    </nav>

    <button
      type="button"
      class="menu-btn"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-open
    >
      <Menu size={22} aria-hidden="true" />
      <span class="sr-only">Open menu</span>
    </button>
  </div>
</header>

<dialog id="mobile-nav" class="mobile-nav" aria-label="Site menu">
  <div class="mobile-head">
    <Wordmark />
    <button type="button" class="menu-btn" data-menu-close>
      <X size={22} aria-hidden="true" />
      <span class="sr-only">Close menu</span>
    </button>
  </div>
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a>
        {l.children && (
          <ul class="sub">
            {l.children.map((c) => (
              <li>
                <a href={c.href} aria-current={isCurrent(c.href) ? 'page' : undefined}>{c.label}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
    <li><a href="/contact" aria-current={path === '/contact' ? 'page' : undefined}>Contact</a></li>
  </ul>
  <a href={cta.primary.href} class="btn btn-primary">{cta.primary.label}</a>
</dialog>

<style>
  #nav-sentinel { position: absolute; top: 0; height: 24px; width: 1px; }

  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--rule);
    transition:
      background-color var(--dur-slow) var(--ease-out-quart),
      border-color var(--dur-slow) var(--ease-out-quart),
      backdrop-filter var(--dur-slow) var(--ease-out-quart);
  }
  /* Transparent over a dark hero until the page scrolls 24px. */
  .site-nav.over-dark:not(.is-stuck) {
    background: transparent;
    border-color: transparent;
    position: fixed;
    inset-inline: 0;
  }
  .site-nav.over-dark.is-stuck {
    position: fixed;
    inset-inline: 0;
    background: color-mix(in oklab, #fff 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.1);
    border-color: var(--rule);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    flex: none;
  }
  .mark { height: 1.75rem; width: auto; }
  .dark-mark { display: none; }
  .over-dark:not(.is-stuck) .light-mark { display: none; }
  .over-dark:not(.is-stuck) .dark-mark { display: block; }
  .brand-word { font-size: 1.5rem; line-height: 1.05; }
  /* The full name is the introduction; the wordmark is the signature. They
     coexist (guide section 2). Below 1024px the nav is too tight for both. */
  .brand-word :global(.full) { display: none; }
  @media (min-width: 1024px) { .brand-word :global(.full) { display: block; } }
  /* The wordmark's colours are set inline by its own component, and the class
     hook lives in that component's output, so the whole child selector has to
     be global for the over-dark override to reach it. */
  .site-nav.over-dark:not(.is-stuck) :global(.brand-word b) { color: #fff !important; }
  .site-nav.over-dark:not(.is-stuck) :global(.brand-word .tail) { color: var(--color-teal-light) !important; }
  .site-nav.over-dark:not(.is-stuck) :global(.brand-word .full) { color: var(--color-teal-pale) !important; }

  .desktop-nav { display: none; align-items: center; gap: 1.75rem; }
  .desktop-nav ul {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .desktop-nav a:not(.btn) {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-navy);
    text-decoration: none;
    padding-block: 0.5rem;
    border-bottom: 2px solid transparent;
    transition: border-color var(--dur-fast), color var(--dur-fast);
  }
  .desktop-nav a:not(.btn):hover { border-bottom-color: var(--color-teal); }
  .desktop-nav a[aria-current='page'] { border-bottom-color: var(--color-teal); }
  .over-dark:not(.is-stuck) .desktop-nav a:not(.btn) { color: #fff; }
  .nav-cta { padding: 0.6rem 1.1rem; min-height: 2.5rem; font-size: 0.9375rem; }

  /* Workshops carries its own pages. The parent stays a real link, and the
     chevron is a separate control, so the group is reachable both ways. */
  .has-menu { position: relative; display: flex; align-items: center; gap: 0.15rem; }
  .disclose {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .disclose :global(svg) { transition: transform var(--dur-fast) var(--ease-out-quart); }
  .has-menu[data-open] .disclose :global(svg) { transform: rotate(180deg); }
  .over-dark:not(.is-stuck) .disclose { color: #fff; }

  .panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: -0.75rem;
    min-width: 17rem;
    padding: 0.4rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: #fff;
    box-shadow: var(--shadow-lift);
  }
  .panel[hidden] { display: none; }
  @media (prefers-reduced-motion: no-preference) {
    .panel { animation: panel-in 160ms var(--ease-out-quart) both; }
  }
  @keyframes panel-in {
    from { opacity: 0; transform: translateY(-4px); }
    to { opacity: 1; transform: none; }
  }
  .panel ul { display: block; gap: 0; }
  .panel li + li { margin-top: 1px; }
  .panel a {
    display: block;
    padding: 0.55rem 0.7rem;
    border-radius: 6px;
    border-bottom: 0 !important;
    font-size: 0.9375rem;
    color: var(--color-navy) !important;
  }
  .panel a:hover { background: var(--color-mist); }
  .panel a[aria-current='page'] { color: var(--color-teal-deep) !important; background: var(--color-mist); }

  .menu-btn {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--color-navy);
    cursor: pointer;
  }
  .menu-btn:hover { background: var(--color-mist); }
  .over-dark:not(.is-stuck) .menu-btn { color: #fff; }

  @media (min-width: 1024px) {
    .desktop-nav { display: flex; }
    .menu-btn { display: none; }
    .mobile-head .menu-btn { display: inline-grid; }
  }

  .mobile-nav {
    margin: 0 0 0 auto;
    height: 100dvh;
    max-height: 100dvh;
    width: min(20rem, 88vw);
    max-width: 88vw;
    border: 0;
    padding: 1.25rem;
    background: #fff;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .mobile-nav::backdrop { background: rgb(15 40 54 / 0.5); }
  .mobile-nav[open] { animation: slide-in 250ms var(--ease-out-expo); }
  @keyframes slide-in {
    from { transform: translateX(100%); }
    to { transform: none; }
  }
  .mobile-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.25rem;
  }
  .mobile-nav ul { list-style: none; margin: 0; padding: 0; flex: 1; }
  .mobile-nav li + li { border-top: 1px solid var(--rule); }
  .mobile-nav ul a {
    display: block;
    padding: 0.9rem 0.25rem;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--color-navy);
    text-decoration: none;
  }
  .mobile-nav ul a[aria-current='page'] { color: var(--color-teal-deep); }
  .mobile-nav .sub { border-left: 2px solid var(--color-mist); margin: 0 0 0.6rem 0.25rem; }
  .mobile-nav .sub li + li { border-top: 0; }
  .mobile-nav .sub a { padding: 0.6rem 0.75rem; font-size: 0.9375rem; color: var(--color-slate); }
</style>

<script>
  const wire = () => {
    const header = document.querySelector<HTMLElement>('.site-nav');
    const sentinel = document.querySelector('#nav-sentinel');
    if (header && sentinel) {
      const io = new IntersectionObserver(
        ([e]) => header.classList.toggle('is-stuck', !e.isIntersecting),
        { threshold: 0 }
      );
      io.observe(sentinel);
    }
    // Workshops group: click or keyboard toggles, pointer hover opens, Escape
    // and an outside click close it.
    document.querySelectorAll<HTMLElement>('[data-menu]').forEach((group) => {
      const btn = group.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const panel = group.querySelector<HTMLElement>('[data-menu-panel]');
      if (!btn || !panel) return;
      const set = (open: boolean) => {
        panel.hidden = !open;
        btn.setAttribute('aria-expanded', String(open));
        group.toggleAttribute('data-open', open);
      };
      btn.addEventListener('click', () => set(panel.hidden));
      if (window.matchMedia('(hover: hover)').matches) {
        group.addEventListener('pointerenter', () => set(true));
        group.addEventListener('pointerleave', () => set(false));
      }
      group.addEventListener('focusout', (e) => {
        if (!group.contains(e.relatedTarget as Node)) set(false);
      });
      group.addEventListener('keydown', (e) => {
        if ((e as KeyboardEvent).key === 'Escape') { set(false); btn.focus(); }
      });
      document.addEventListener('click', (e) => {
        if (!group.contains(e.target as Node)) set(false);
      });
    });

    const dlg = document.querySelector<HTMLDialogElement>('#mobile-nav');
    const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
    openBtn?.addEventListener('click', () => {
      dlg?.showModal();
      openBtn.setAttribute('aria-expanded', 'true');
    });
    closeBtn?.addEventListener('click', () => dlg?.close());
    dlg?.addEventListener('close', () => openBtn?.setAttribute('aria-expanded', 'false'));
    dlg?.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });
    dlg?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => dlg.close()));
  };
  wire();
  document.addEventListener('astro:page-load', wire);
</script>
