---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProofPoints from '../components/ProofPoints.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbs } from '../data/schema';
import { founder, brand } from '../data/contact';

const pillars = [
  {
    n: '01',
    name: 'Practical',
    line: 'Working tools, not theory. Every session ends with something you can use Monday, and if a session would not produce that we will tell you before you book it.',
  },
  {
    n: '02',
    name: 'Local',
    line: 'A neighbor, not a vendor. The examples come from businesses on this side of the Front Range, the delivery is in person, and when something breaks in March we are 20 minutes away.',
  },
  {
    n: '03',
    name: 'Proven',
    line: '25 years of building digital products across more than 25 industries, most recently leading solutions consulting for enterprise clients. The methods are the same. The pricing is not.',
  },
  {
    n: '04',
    name: 'Honest',
    line: 'We will tell you when AI is not the answer, when a cheaper tool covers it, and when the problem you have described is really a process problem. That costs us work and it is the point.',
  },
];
---

<Base
  title="About Idea Collaborative: a neighbor, not a vendor"
  description="Idea Collaborative is a Loveland-based AI consultancy run by Josh Scott, with 25+ years building digital products across more than 25 industries."
  path="/about"
  darkHero
  schemas={[breadcrumbs([{ name: 'About', path: '/about' }])]}
>
  <Hero
    chapter="01"
    label="About"
    headline="A <em>neighbor</em>, not a vendor."
    sub="Idea Collaborative is one experienced person and a short list of things worth doing well, based in Loveland and working across Northern Colorado."
    photo
    variant={3}
    compact
  />

  <Section surface="white" class="crumb-row">
    <Breadcrumbs trail={[{ name: 'About', path: '/about' }]} />
  </Section>

  <Section chapter="02" label="Who runs it" surface="white">
    <div class="bio">
      <div class="portrait">
        <!-- TODO for Josh: environmental photo, in Loveland, not a headshot on grey.
             Drop it at src/assets/josh.jpg and swap this block for an <Image />. -->
        <div class="portrait-slot" role="img" aria-label="Photograph of Josh Scott, to be added">
          <span>Photograph<br />to come</span>
        </div>
      </div>
      <div>
        <h2 class="display-lg">Josh <em>Scott</em>.</h2>
        <p class="lede">
          Josh Scott has spent 25+ years building digital products across more than 25 industries,
          most recently leading solutions consulting for enterprise clients. He founded Idea
          Collaborative to bring that same discipline to the businesses in his own community. He
          lives in Loveland with his family and believes the best technology decision is usually the
          one that solves an actual problem.
        </p>
        <p>
          The short version of why this exists: the methods large companies use to decide what to
          build, what to skip, and how to tell whether it worked are not complicated. They are just
          expensive to buy. A 20-person business deserves the same discipline, at a price that makes
          sense for a 20-person business.
        </p>
        <p>
          <a href={founder.linkedin} class="prose-link" rel="me">Josh on LinkedIn</a>
        </p>
      </div>
    </div>
  </Section>

  <Section chapter="03" label="Four pillars" surface="ink">
    <h2 class="display-lg">What this is <em>built</em> on.</h2>
    <ol class="pillars reveal-stagger">
      {pillars.map((p, i) => (
        <li style={`--i:${i}`}>
          <span class="n">{p.n}</span>
          <h3 class="display-md">{p.name}</h3>
          <p>{p.line}</p>
        </li>
      ))}
    </ol>
    <ProofPoints />
  </Section>

  <Section chapter="04" label="Results" surface="cloud">
    <div class="results">
      <h2 class="display-lg">There is no <em>results</em> section here yet.</h2>
      <p class="lede">
        Idea Collaborative is new. There are no case studies on this page because there are not
        three finished ones to write about, and a page of invented numbers would contradict the
        thing we are selling.
      </p>
      <p>
        What is here instead is 25 years of work that happened somewhere else, priced transparently,
        with a workshop you can leave without paying if your team cannot name something worth doing.
        When the first three engagements are done, named clients and real numbers will replace this
        paragraph.
      </p>
      <p class="fine">
        If you would like to talk to somebody about the enterprise work rather than this business,
        ask and we will make an introduction.
      </p>
    </div>
  </Section>

  <Section chapter="05" label="The boilerplate" surface="white">
    <div class="boiler">
      <p class="chapter">For press and partners</p>
      <p class="quote">{brand.boilerplate}</p>
    </div>
  </Section>

  <CtaBand
    chapter="06"
    headline="Ask the <em>awkward</em> question first."
    sub="Whether this is worth your money is a fair thing to ask before you spend any. Describe your week and we will answer it straight."
  />
</Base>

<style>
  .crumb-row { padding-block: 1.25rem !important; border-bottom: 1px solid var(--rule); }
  .lede { font-size: 1.125rem; color: var(--color-slate); }
  :global(.on-dark) .lede { color: color-mix(in oklab, var(--color-cloud) 82%, var(--color-teal-pale)); }

  .bio { display: grid; gap: clamp(2rem, 1.5rem + 3vw, 3.5rem); align-items: start; }
  @media (min-width: 860px) { .bio { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); } }
  .bio h2 { margin: 0 0 1.25rem; }
  .bio p { color: var(--color-slate); }
  .portrait-slot {
    aspect-ratio: 4 / 5;
    border-radius: 8px;
    display: grid;
    place-items: center;
    text-align: center;
    background: linear-gradient(135deg, #1c3e54 0%, #2c6671 55%, #3c8e8e 100%);
    color: color-mix(in oklab, #fff 78%, transparent);
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .pillars { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .pillars { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; } }
  .pillars .n { font-family: var(--font-display); font-size: 0.875rem; letter-spacing: 0.08em; color: var(--color-teal-light); }
  .pillars h3 { margin: 0.35rem 0 0.5rem; color: #fff; }
  .pillars p { margin: 0; }

  .results { max-width: 46rem; }
  .results h2 { margin: 0 0 1.25rem; }
  .results p { color: var(--color-slate); }
  .fine { font-size: 0.875rem; }

  .boiler { max-width: 46rem; }
  .quote {
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.45;
    color: var(--color-navy);
    border-left: 3px solid var(--color-teal);
    padding-left: 1.25rem;
    margin: 0;
  }
</style>
