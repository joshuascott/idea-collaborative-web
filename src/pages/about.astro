---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProofPoints from '../components/ProofPoints.astro';
import CtaBand from '../components/CtaBand.astro';
import { breadcrumbs } from '../data/schema';

const pillars = [
  {
    n: '01',
    name: 'Practical',
    line: 'Working tools, not theory. Every session ends with something you can use Monday, and if a session would not produce that we will tell you before you book it.',
  },
  {
    n: '02',
    name: 'Local',
    line: 'We are a neighbor, not a vendor. The examples come from businesses on this side of the Front Range, the delivery is in person, and when something breaks in March we are 20 minutes away.',
  },
  {
    n: '03',
    name: 'Proven',
    line: '25 years of building digital products across more than 25 industries, most recently leading solutions consulting for enterprise clients. The methods are the same. The pricing is not.',
  },
  {
    n: '04',
    name: 'Honest',
    line: 'We will tell you when AI is not the answer, when a cheaper tool covers it, and when the problem you have described is really a process problem. That costs us work and it is the point.',
  },
];
---

<Base
  title="About Idea Collaborative: a neighbor, not a vendor"
  description="Idea Collaborative is a Loveland-based AI consultancy with 25+ years building digital products across more than 25 industries."
  path="/about"
  darkHero
  schemas={[breadcrumbs([{ name: 'About', path: '/about' }])]}
>
  <Hero
    chapter="01"
    label="About"
    headline="A <em>neighbor</em>, not a vendor."
    sub="We sit with Northern Colorado business owners and stay after the workshop, the way a neighbor does, not a remote vendor."
    photo
    variant={3}
    compact
  />

  <Section chapter="02" label="Who we are" surface="white" class="who-we-are">
    <div slot="before" class="crumb-above">
      <Breadcrumbs trail={[{ name: 'About', path: '/about' }]} />
    </div>
    <div class="about-body">
      <h2 class="display-lg">Enterprise methods. <em>Local</em> delivery.</h2>
      <p class="lede">
        Our team has spent 25+ years building digital products across more than 25 industries,
        most recently leading solutions consulting for enterprise clients. Idea Collaborative
        brings that same discipline to the businesses in our own community, at the moment when
        what is worth building can finally be built without years of wait or a long handoff.
      </p>
      <p>
        The short version of why this exists: the methods large companies use to decide what to
        build, what to skip, and how to tell whether it worked are not complicated. They are just
        expensive to buy. A 20-person business deserves the same discipline, at a price that makes
        sense for a 20-person business.
      </p>
      <p>
        For the work itself, start with
        <a href="/workshops" class="prose-link">the three workshops</a>
        or
        <a href="/consulting" class="prose-link">hands-on consulting</a>.
      </p>
    </div>
  </Section>

  <Section chapter="03" label="Four pillars" surface="ink">
    <h2 class="display-lg">What this is <em>built</em> on.</h2>
    <ol class="pillars reveal-stagger">
      {pillars.map((p, i) => (
        <li style={`--i:${i}`}>
          <span class="n">{p.n}</span>
          <h3 class="display-md">{p.name}</h3>
          <p>{p.line}</p>
        </li>
      ))}
    </ol>
    <ProofPoints />
  </Section>

  <CtaBand
    chapter="04"
    headline="Ask the <em>awkward</em> question first."
    sub="Whether this is worth your money is a fair thing to ask before you spend any. Describe your week and we will answer it straight."
  />
</Base>

<style>
  /* Page-scoped .crumb-row / .after-crumb never reached Section's .surface
     (different data-astro-cid). One section + before slot; pad via :global.
     Must beat .surface[data-astro-cid] (0,2,0) so padding-top wins over padding-block. */
  :global(section.surface.who-we-are) {
    padding-top: 1.25rem;
  }
  /* Lives in this page's markup, so scoped styles apply. ~1rem to chapter. */
  .crumb-above {
    margin: 0 0 1rem;
  }
  .lede { font-size: 1.125rem; color: var(--color-slate); }
  :global(.on-dark) .lede { color: color-mix(in oklab, var(--color-cloud) 82%, var(--color-teal-pale)); }

  .about-body { max-width: 46rem; }
  .about-body h2 { margin: 0 0 1.25rem; }
  .about-body p { color: var(--color-slate); }

  .pillars { list-style: none; margin: 0; padding: 0; display: grid; gap: 2rem; }
  @media (min-width: 768px) { .pillars { grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; } }
  .pillars .n { font-family: var(--font-display); font-size: 0.875rem; letter-spacing: 0.08em; color: var(--color-teal-light); }
  .pillars h3 { margin: 0.35rem 0 0.5rem; color: #fff; }
  .pillars p { margin: 0; }
</style>
