{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/workshops.html",
        "http://localhost/workshops/ai-advantage.html",
        "http://localhost/workshops/implementation-bootcamp.html",
        "http://localhost/workshops/leadership-intensive.html",
        "http://localhost/consulting.html",
        "http://localhost/realtors.html",
        "http://localhost/about.html",
        "http://localhost/contact.html",
        "http://localhost/ai-readiness-assessment.html",
        "http://localhost/ai-briefing-breakfast.html",
        "http://localhost/blog.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
